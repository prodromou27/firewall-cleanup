# PolicyInsight Docker/compose configuration - copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets.

# PostgreSQL
POSTGRES_USER=policyinsight
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=policyinsight

# Backend
# Local dev default is SQLite. Docker overrides this with PostgreSQL.
# Examples:
#   sqlite:///./firewall_cleanup.db
#   postgresql+psycopg2://policyinsight:password@db:5432/policyinsight
DATABASE_URL=sqlite:///./firewall_cleanup.db

# Fernet key for encrypting stored device credentials. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# "production" disables the interactive API docs AND enforces the HTTPS security
# gate (HTTPS-only cookies + non-localhost origins). For a plain-HTTP DEV/LAN box
# use "development" so http/localhost origins are allowed; use "production" only
# behind TLS (with COOKIE_SECURE=true and an https:// origin below).
ENVIRONMENT=development

# Public HTTPS origin(s) the app is served from (comma-separated). Match the URL users hit.
ALLOWED_ORIGINS=https://policyinsight.example.com

# Optional: allow whole LAN subnets as origins (comma-separated CIDRs).
ALLOWED_ORIGIN_SUBNETS=

# Production requires HTTPS-only cookies.
COOKIE_SECURE=true

# Backend storage and limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# Session and rate limiting
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60
RATE_LIMIT_PER_MINUTE=300

# Keep false in production. Setting true allows localhost/link-local/metadata device targets.
ALLOW_UNSAFE_DEVICE_HOSTS=false

# Seed an initial system admin on a fresh database (change the password after first login).
BOOTSTRAP_ADMIN_EMAIL=admin@policyinsight.local
BOOTSTRAP_ADMIN_PASSWORD=

# Optional analysis tuning
INACTIVITY_THRESHOLD_LOW=90
INACTIVITY_THRESHOLD_MEDIUM=180
INACTIVITY_THRESHOLD_HIGH=365
# Comma-separated detector families to disable when data quality is insufficient.
# Supported examples: usage,permissive,risky_services,shadowing,unused_objects,service_ranges
ANALYSIS_DISABLED_DETECTORS=
# Prevent one detector from flooding customer reports with thousands of rows.
ANALYSIS_MAX_FINDINGS_PER_TYPE=100

# Frontend / HTTP
# Host port the app is exposed on (plain-HTTP mode).
HTTP_PORT=8080

# TLS (HTTPS on 443 via Caddy, automatic Let's Encrypt)
# Set APP_DOMAIN to a public domain that resolves to this host to enable HTTPS.
# Leave blank for plain HTTP. When set, also set COOKIE_SECURE=true and
# ALLOWED_ORIGINS=https://<APP_DOMAIN>. Needs inbound 80+443 for cert issuance.
APP_DOMAIN=
ACME_EMAIL=
