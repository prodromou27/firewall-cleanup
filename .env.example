# PolicyInsight Docker/compose configuration — copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=policyinsight
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=policyinsight

# ── Backend ──────────────────────────────────────────────────────────────────
# Fernet key for encrypting stored device credentials. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# "production" disables the interactive API docs (/docs, /redoc, /openapi.json).
ENVIRONMENT=production

# Public origin(s) the app is served from (comma-separated). Match the URL users hit.
ALLOWED_ORIGINS=http://localhost:8080

# Optional: allow whole LAN subnets as origins (comma-separated CIDRs).
ALLOWED_ORIGIN_SUBNETS=

# Set true ONLY when serving over HTTPS (cookies become Secure-only).
COOKIE_SECURE=false

# Seed an initial system admin on a fresh database (change the password after first login).
BOOTSTRAP_ADMIN_EMAIL=admin@policyinsight.local
BOOTSTRAP_ADMIN_PASSWORD=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Host port the app is exposed on.
HTTP_PORT=8080
