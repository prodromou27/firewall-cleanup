# PolicyInsight backend configuration — the installer writes this to
# backend/.env. Shown here for reference; `deploy/almalinux-install.sh`
# generates it automatically (with fresh secrets) on first run.

# PostgreSQL connection (the installer creates the role/db and fills this in).
DATABASE_URL=postgresql+psycopg2://policyinsight:CHANGE_ME@127.0.0.1:5432/policyinsight

# Fernet key for encrypting stored device credentials. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
SECRET_KEY=

# "production" disables the interactive API docs (/docs, /redoc, /openapi.json).
ENVIRONMENT=production

# Public origin(s) users hit (comma-separated). Match the server URL.
ALLOWED_ORIGINS=http://localhost

# Optional: allow whole LAN subnets as origins (comma-separated CIDRs).
ALLOWED_ORIGIN_SUBNETS=

# Set true only when serving over HTTPS.
COOKIE_SECURE=false

# Seed an initial admin on a fresh database (change the password after first login).
BOOTSTRAP_ADMIN_EMAIL=admin@policyinsight.local
BOOTSTRAP_ADMIN_PASSWORD=

# Where uploaded policy files are stored.
UPLOAD_DIR=./uploads
