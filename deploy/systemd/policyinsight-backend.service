[Unit]
Description=PolicyInsight backend (FastAPI / uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__REPO_DIR__/backend
EnvironmentFile=__REPO_DIR__/backend/.env
ExecStart=__REPO_DIR__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-server-header
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
