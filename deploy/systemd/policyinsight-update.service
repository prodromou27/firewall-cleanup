[Unit]
Description=PolicyInsight self-update (pull this host's branch and redeploy if changed)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
ExecStart=/bin/bash __REPO_DIR__/deploy/update.sh --if-changed
# Run as root so docker + git operate without sudo (installer marks the repo
# as a safe.directory for root). Output goes to the journal.
User=root
